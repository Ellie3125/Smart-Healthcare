# Mẫu cho môi trường dev. Sao chép thành .env.dev (đã bị .gitignore) rồi đặt mật khẩu thật của máy bạn.
# Không commit .env.dev. Mật khẩu SQL Server cần đủ độ phức tạp (≥ 8 ký tự, hoa, thường, số, ký hiệu) và không chứa dấu nháy đơn.

# SQL Server: Developer chỉ dùng cho dev/test; edition Staging/Prod chốt theo DB-01.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=CHANGE_ME_Sa_Passw0rd!

# Login runtime của Api/Worker (không dùng sa trong runtime).
SQL_APP_LOGIN=sh_app
SQL_APP_PASSWORD=CHANGE_ME_App_Passw0rd!

# TrustServerCertificate=True chỉ chấp nhận được trên mạng Docker nội bộ của laptop dev, nơi SQL Server dùng chứng chỉ tự ký.
# Staging/Prod phải dùng chứng chỉ hợp lệ và bỏ tùy chọn này (cấm tắt xác minh TLS).
APP_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sh_app;Password=CHANGE_ME_App_Passw0rd!;Encrypt=True;TrustServerCertificate=True
MIGRATION_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sa;Password=CHANGE_ME_Sa_Passw0rd!;Encrypt=True;TrustServerCertificate=True

APP_ENVIRONMENT=Development
API_IMAGE=smart-healthcare/api:dev
WORKER_IMAGE=smart-healthcare/worker:dev
API_HOST_PORT=8080
