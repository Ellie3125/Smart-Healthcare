# Mẫu cho môi trường dev. Sao chép thành .env.dev (đã bị .gitignore) rồi thay mọi giá trị <...> bằng giá trị của máy bạn.
# Không commit .env.dev. Mật khẩu SQL Server cần đủ độ phức tạp (≥ 8 ký tự, hoa, thường, số, ký hiệu) và không chứa dấu nháy đơn.

# SQL Server: Developer chỉ dùng cho dev/test; edition Staging/Prod chốt theo DB-01.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=<mat-khau-sa>

# Login runtime của Api/Worker (không dùng sa trong runtime).
SQL_APP_LOGIN=sh_app
SQL_APP_PASSWORD=<mat-khau-sh_app>

# Hai chuỗi kết nối phải dùng đúng hai mật khẩu ở trên.
# TrustServerCertificate=True chỉ chấp nhận được trên mạng Docker nội bộ của laptop dev, nơi SQL Server dùng chứng chỉ tự ký.
# Staging/Prod phải dùng chứng chỉ hợp lệ và bỏ tùy chọn này (cấm tắt xác minh TLS).
APP_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sh_app;Password=<mat-khau-sh_app>;TrustServerCertificate=True
MIGRATION_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sa;Password=<mat-khau-sa>;TrustServerCertificate=True

# Khóa ký JWT, tối thiểu 32 byte (ví dụ tạo bằng: openssl rand -base64 48).
JWT_SIGNING_KEY=<khoa-jwt-it-nhat-32-ky-tu>

# Mật khẩu chung của các tài khoản demo do Api seed khi chạy Development.
SEED_DEFAULT_PASSWORD=<mat-khau-tai-khoan-demo>

# VNPAY sandbox (Giải pháp kỹ thuật v2.13 mục 5.4). Để trống thì Api vẫn chạy nhưng không tạo được liên kết thanh toán.
# ReturnUrl và IPN URL cần địa chỉ public (tunnel) trỏ vào http://127.0.0.1:${API_HOST_PORT}.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=

APP_ENVIRONMENT=Development
API_IMAGE=smart-healthcare/api:dev
WORKER_IMAGE=smart-healthcare/worker:dev
API_HOST_PORT=8080
