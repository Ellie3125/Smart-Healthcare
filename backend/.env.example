# Chọn nơi chạy database cho Api và Worker khi chạy bằng dotnet run.
# Chép file này thành backend/.env. Bỏ dấu # ở ĐÚNG MỘT dòng ConnectionStrings bên dưới để dùng dòng đó.
# Để cả hai dòng có dấu # thì Api/Worker lấy chuỗi kết nối trong user-secrets như trước.
# File .env thật không được commit.

# 1) SQL Server cài trên máy (sửa tên database cho đúng máy bạn)
#ConnectionStrings__SmartHealthcare=Server=.\SQLEXPRESS;Database=SmartHealthcare;Trusted_Connection=True;TrustServerCertificate=True

# 2) SQL Server trong Docker Compose. Bật trước bằng:
#    docker compose --env-file .env.dev -f compose.yaml -f compose.dev.yaml up -d sqlserver db-init migrator
#    Cổng: SQL_HOST_PORT trong .env.dev (mặc định 14333). Tài khoản: SQL_APP_LOGIN / SQL_APP_PASSWORD trong .env.dev.
#ConnectionStrings__SmartHealthcare=Server=127.0.0.1,14333;Database=SmartHealthcare;User Id=<SQL_APP_LOGIN>;Password=<SQL_APP_PASSWORD>;TrustServerCertificate=True
