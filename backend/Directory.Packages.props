    <PackageVersion Include="Hangfire.NetCore" Version="1.8.25" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient 6.1.7 kÃ©o báº£n 9.0.11 cÃ³ GHSA-846f-f764-76mx (high), GHSA-2fmv-rv2c-59x7 -->
