{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)"
    ]
  }
}
