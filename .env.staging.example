# Mẫu cho VPS Staging. Sao chép thành .env.staging trên VPS (đã bị .gitignore), thay mọi giá trị <...>. Không commit .env.staging.
# Dùng với: scripts/deploy-staging.sh (ghép compose.yaml + compose.staging.yaml).
# Mật khẩu SQL Server: ≥ 8 ký tự, có hoa, thường, số, ký hiệu; không chứa dấu nháy đơn hoặc dấu chấm phẩy.

# TẠM: Development. Scheduling chỉ gắn endpoint đặt lịch (ngày trực, tìm bác sĩ, giữ chỗ, lịch hẹn) và danh bạ bác sĩ giả lập khi
# môi trường là Development (Scheduling.Api/DependencyInjection.cs). Để Staging thì web bệnh nhân không đặt lịch được.
# Swagger/OpenAPI của Development bị nginx chặn ở cả hai host. Đổi sang Staging khi Scheduling có danh bạ bác sĩ thật.
APP_ENVIRONMENT=Development

# ---- Image theo digest (OPS-02): scripts/build-images.sh in sẵn 4 dòng này ----
API_IMAGE=<registry>/smart-healthcare/api@sha256:<digest>
WORKER_IMAGE=<registry>/smart-healthcare/worker@sha256:<digest>
MIGRATOR_IMAGE=<registry>/smart-healthcare/migrator@sha256:<digest>
WEB_IMAGE=<registry>/smart-healthcare/web@sha256:<digest>

# ---- Host (Giải pháp kỹ thuật §8.6). Staging dùng host riêng, cùng cấu trúc với Prod ----
# Ví dụ: staging.smarthealthcare.io.vn
PUBLIC_HOST=<host-web-benh-nhan>
# Ví dụ: staff-staging.smarthealthcare.io.vn (đặt sau Cloudflare Access)
STAFF_HOST=<host-web-nhan-vien>
# Token của tunnel (Cloudflare Zero Trust → Networks → Tunnels). Public hostname: cả hai host trỏ http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=<token>
# Mạng Docker giữa nginx và Api; Api chỉ tin X-Forwarded-For từ dải này. Chọn dải không trùng mạng sẵn có trên VPS.
BACKEND_SUBNET=172.28.10.0/24

# ---- SQL Server ----
# Edition chốt theo DB-01 (Developer chỉ cho dev/test; Express miễn phí, giới hạn 10 GB/DB).
MSSQL_PID=Express
MSSQL_SA_PASSWORD=<mat-khau-sa>
SQL_APP_LOGIN=sh_app
SQL_APP_PASSWORD=<mat-khau-sh_app>
# TẠM: SQL Server trong Docker dùng chứng chỉ tự ký nên phải TrustServerCertificate=True. GP yêu cầu Staging/Prod dùng chứng chỉ
# hợp lệ; còn nợ việc gắn chứng chỉ cho SQL Server rồi bỏ tùy chọn này. Kết nối chỉ đi trong mạng Docker backend, không ra ngoài VPS.
APP_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sh_app;Password=<mat-khau-sh_app>;Encrypt=True;TrustServerCertificate=True
MIGRATION_DB_CONNECTION=Server=sqlserver;Database=SmartHealthcare;User Id=sa;Password=<mat-khau-sa>;Encrypt=True;TrustServerCertificate=True

# ---- Ứng dụng ----
# Khóa ký JWT, tối thiểu 32 byte, khác với dev (openssl rand -base64 48).
JWT_SIGNING_KEY=<khoa-jwt>
# Staging bật seed để có tài khoản demo (cấp bậc, phòng, nhân viên, bác sĩ). Prod: SEED_ENABLED=false.
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=<mat-khau-tai-khoan-demo>

# ---- VNPAY sandbox (Giải pháp kỹ thuật §5.4) ----
# Trên trang merchant sandbox khai IPN URL: https://<PUBLIC_HOST>/api/billing/payments/vnpay/ipn
VNPAY_TMN_CODE=<tmn-code>
VNPAY_HASH_SECRET=<hash-secret>
VNPAY_RETURN_URL=https://<PUBLIC_HOST>/payment/vnpay-return

# ---- Cloudflare R2 (tệp kết quả CLS, bucket private). Staging phải điền đủ 4 biến đầu: thiếu thì Api lưu tệp tạm trong RAM,
# mất khi restart container. R2_SERVICE_URL để trống thì dùng endpoint mặc định theo AccountId ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SERVICE_URL=
