# Nginx sau Cloudflare Tunnel (Giải pháp kỹ thuật v2.13 §8.6). Image nginx thay ${PUBLIC_HOST}, ${STAFF_HOST} lúc khởi động
# (envsubst chỉ thay biến môi trường đã khai; biến của nginx như $host giữ nguyên).
#   ${PUBLIC_HOST}: web bệnh nhân + API kênh Patient + IPN VNPAY; public, không đặt sau Cloudflare Access.
#   ${STAFF_HOST}:  web nhân viên + API nội bộ; đặt sau Cloudflare Access (email nhân viên VÀ máy bệnh viện).
# Mỗi host chỉ phục vụ bản build của nó và chặn tuyến của kênh kia. Backend vẫn kiểm kênh trong token cho từng endpoint;
# chặn ở đây chỉ là lớp bảo vệ thêm. Không cần CORS: mỗi host gọi API cùng origin.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# DNS nội bộ của Docker. Phân giải lại tên service định kỳ: mỗi lần triển khai, container api mới có IP mới; không có bước này
# nginx giữ IP cũ và trả 502 cho tới khi khởi động lại.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream smart_healthcare_api {
    # Docker DNS trả mọi replica của service api; nginx chia vòng tròn, không sticky (SignalR dùng WebSockets, skipNegotiation).
    zone smart_healthcare_api 64k;
    server api:8080 resolve;
    keepalive 16;
}

server_tokens off;
gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

# Host lạ hoặc gọi thẳng IP: đóng kết nối. /healthz cho healthcheck của compose (Host: localhost).
server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        return 444;
    }
}

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    root /usr/share/nginx/html/patient;
    client_max_body_size 1m;
    include /etc/nginx/snippets/security-headers.conf;

    # Tuyến nội bộ không đi qua host công khai.
    location ~ ^/api/(staff|[a-z-]+/(staff|admin))(/|$) { return 404; }
    location ~ ^/auth/(staff|room)(/|$)                 { return 404; }
    location ~ ^/hubs/staff(/|$)                        { return 404; }
    location ~ ^/(swagger|openapi|dev|hangfire)(/|$)    { return 404; }

    include /etc/nginx/snippets/api-proxy.conf;
    include /etc/nginx/snippets/spa.conf;
}

server {
    listen 80;
    server_name ${STAFF_HOST};
    root /usr/share/nginx/html/staff;
    # Phòng CLS tải tệp kết quả tối đa 20 MB (DocumentsReporting FileValidationHelper).
    client_max_body_size 21m;
    include /etc/nginx/snippets/security-headers.conf;

    # Tuyến của bệnh nhân và IPN VNPAY chỉ đi qua host công khai.
    location ~ ^/api/(patient|[a-z-]+/(patient|public))(/|$) { return 404; }
    location ^~ /api/billing/payments/vnpay/                  { return 404; }
    location ~ ^/auth/patient(/|$)                            { return 404; }
    location ~ ^/hubs/(patient|public-display)(/|$)           { return 404; }
    location ~ ^/(swagger|openapi|dev|hangfire)(/|$)          { return 404; }

    include /etc/nginx/snippets/api-proxy.conf;
    include /etc/nginx/snippets/spa.conf;
}
